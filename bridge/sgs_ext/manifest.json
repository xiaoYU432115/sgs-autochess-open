{
  "manifest_version": 3,
  "name": "三国杀自走棋助手 · 全能扩展",
  "version": "1.3.0",
  "description": "一份顶两份：主脚本由助手下发（不内置，源脚本一改在助手里点『更新全能扩展脚本』就换新的）+ GoRes 同款网络层资源重定向 + 油猴式管理页（脚本管理/添加脚本/获取新脚本/设置/实用工具）。装这一个就不用再装 Tampermonkey。",
  "minimum_chrome_version": "120",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "unlimitedStorage",
    "alarms",
    "tabs",
    "scripting",
    "userScripts"
  ],
  "host_permissions": [
    "*://web.sanguosha.com/*",
    "*://www.sanguosha.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://web.sanguosha.com/*",
        "*://www.sanguosha.com/*"
      ],
      "js": [
        "content/agent.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "自走棋助手 · 全能扩展"
  },
  "commands": {
    "toggle-scripts": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "停用/启用脚本注入（含主脚本）"
    }
  }
}
